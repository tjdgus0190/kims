# 관리자 로그인 비밀번호 (반드시 변경하세요)
ADMIN_PASSWORD=change-me-please
# 로그인 쿠키 서명용 임의 문자열 (길고 무작위로)
SESSION_SECRET=replace-with-a-long-random-string
# 실제 도메인 (검색엔진 sitemap / 대표 URL 용)
SITE_URL=https://www.example.com
PORT=3000
NODE_ENV=production
# 선택: 새 문의 알림을 받을 웹훅 주소 (슬랙/디스코드 등)
INQUIRY_WEBHOOK_URL=
# 선택: 데이터/업로드 저장 위치 (배포 환경의 영구 디스크 경로)
# DATA_DIR=/var/data
# UPLOAD_DIR=/var/data/uploads
