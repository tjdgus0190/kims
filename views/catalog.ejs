<%- include('partials/head') %>
<%- include('partials/header', { bodyClass: 'is-sub is-catalog' }) %>
<% const awardYears = lines(settings.awardYears, /[\n,]/); const today = new Date(); %>

<main id="main" class="catalog-page">
  <section class="cat-cover">
    <div class="container cat-cover__grid">
      <div>
        <p class="eyebrow" data-reveal>PRODUCT CATALOG <%= today.getFullYear() %></p>
        <h1 class="cat-cover__title" data-split><%= settings.productBrandEn || 'INTERRA' %></h1>
        <p class="cat-cover__sub" data-reveal><%= settings.brandName %> · <%= settings.productBrand %> 제품 카탈로그</p>
        <p class="lead" data-reveal>전 제품 <%= total %>종의 소비자가와 주요 특징을 한눈에 확인하세요. <br class="br-pc">구매와 상담은 대표번호로 문의해 주세요.</p>
        <div class="cat-tools" data-reveal>
          <a class="btn" href="<%= telHref(settings.phone) %>" data-magnetic>구매 문의 <%= settings.phone %></a>
          <button class="btn btn--ghost" type="button" data-print>인쇄 · PDF 저장</button>
          <button class="btn btn--ghost" type="button" data-copy-link>카탈로그 링크 복사</button>
        </div>
        <nav class="cat-index" aria-label="카테고리 바로가기" data-reveal>
          <% groups.forEach(function (g, i) { %><a href="#cat-<%= i %>"><%= g.name %> <small><%= g.items.length %></small></a><% }) %>
        </nav>
      </div>
      <% if (awardYears.length) { %>
      <div class="seal seal--lg" data-reveal aria-label="<%= settings.awardTitle %> <%= settings.awardBadge %>">
        <svg class="seal__ring" viewBox="0 0 200 200" aria-hidden="true"><defs><path id="seal-path-c" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"/></defs>
          <text><textPath href="#seal-path-c"><%= settings.awardTitle %> · <%= awardYears.join(' · ') %> · </textPath></text></svg>
        <span class="seal__core"><small>AWARD</small><strong><%= settings.awardBadge %></strong></span>
      </div>
      <% } %>
    </div>
  </section>

  <% groups.forEach(function (g, gi) { %>
  <section class="cat-group" id="cat-<%= gi %>">
    <div class="container">
      <header class="cat-group__head" data-reveal>
        <h2><%= g.name %></h2>
        <span><%= g.items.length %>개 제품</span>
      </header>
      <div class="cat-list">
        <% g.items.forEach(function (p) { %>
        <article class="cat-item" data-reveal>
          <a class="cat-item__media" href="<%= productUrl(p) %>">
            <% if (p.images && p.images[0]) { %><img src="<%= p.images[0] %>" alt="<%= p.name %>" loading="lazy" width="800" height="1000"><% } %>
            <% if (p.badge) { %><span class="p-card__badge"><%= p.badge %></span><% } %>
          </a>
          <div class="cat-item__body">
            <p class="p-card__meta"><%= [p.brand, p.category, p.capacity].filter(Boolean).join(' · ') %></p>
            <h3><a href="<%= productUrl(p) %>"><%= p.name %></a></h3>
            <p class="cat-item__summary"><%= p.summary %></p>
            <% if (lines(p.highlights).length) { %>
            <ul class="pdp__points pdp__points--sm"><% lines(p.highlights).forEach(function (h) { %><li><%= h %></li><% }) %></ul>
            <% } %>
          </div>
          <div class="cat-item__price">
            <span class="p-card__label">소비자가</span>
            <strong class="<%= p.price ? '' : 'is-ask' %>"><%= p.price ? won(p.price) : '상담 시 안내' %></strong>
            <a class="link-arrow" href="<%= productUrl(p) %>">상세 보기 <span>→</span></a>
          </div>
        </article>
        <% }) %>
      </div>
    </div>
  </section>
  <% }) %>

  <section class="cat-order">
    <div class="container cat-order__grid" data-reveal>
      <div>
        <p class="eyebrow">HOW TO ORDER</p>
        <h2 class="h2">주문 · 상담 안내</h2>
        <ol class="cat-order__steps">
          <li>카탈로그에서 원하시는 제품을 확인합니다.</li>
          <li>대표번호로 전화 또는 문자를 주세요.</li>
          <li>상담 후 안내드리는 계좌로 입금하시면 확인 즉시 발송해 드립니다.</li>
        </ol>
      </div>
      <dl class="cat-order__info">
        <div><dt>구매 문의</dt><dd class="cat-order__phone"><%= settings.phone %></dd></div>
        <div><dt>상호 / 대표</dt><dd><%= settings.brandName %> / <%= settings.ceoName %></dd></div>
        <div><dt>상담시간</dt><dd><%= settings.hours %></dd></div>
        <div><dt>홈페이지</dt><dd><%= siteUrl.replace(/^https?:\/\//, '') %>/catalog</dd></div>
      </dl>
    </div>
    <p class="container cat-order__note">표시된 가격은 소비자가 기준이며, 제품 구성과 가격은 사정에 따라 변경될 수 있습니다. (<%= today.getFullYear() %>.<%= String(today.getMonth() + 1).padStart(2, '0') %> 기준)</p>
  </section>
</main>

<%- include('partials/footer') %>
