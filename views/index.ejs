<%- include('partials/head') %>
<%- include('partials/header', { bodyClass: 'is-home' }) %>

<div class="intro" data-intro aria-hidden="true">
  <div class="intro__mark">
    <% (settings.brandNameEn || 'INTERRA').split('').forEach(function (ch) { %><span><%= ch %></span><% }) %>
  </div>
  <div class="intro__line"></div>
</div>

<main id="main">
  <!-- HERO -->
  <% const awardYears = lines(settings.awardYears, /[\n,]/); %>
  <section class="hero" data-hero>
    <canvas class="hero__canvas" data-peptide-canvas aria-hidden="true"></canvas>
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow hero__eyebrow" data-hero-in><%= settings.heroEyebrow %></p>
        <h1 class="hero__title">
          <% String(settings.heroTitle || '').split('\n').forEach(function (line) { %>
            <span class="line"><span class="line__inner" data-hero-line><%= line %></span></span>
          <% }) %>
        </h1>
        <p class="hero__sub" data-hero-in>
          <% String(settings.heroSubtitle || '').split('\n').forEach(function (line) { %><span><%= line %></span><% }) %>
        </p>
        <div class="hero__cta" data-hero-in>
          <a class="btn" href="/catalog" data-magnetic>제품 카탈로그 보기</a>
          <a class="btn btn--ghost" href="<%= telHref(settings.phone) %>" data-magnetic>전화 구매 문의</a>
        </div>
      </div>
      <% const heroProduct = featured[0]; %>
      <% if (heroProduct && heroProduct.images && heroProduct.images[0]) { %>
      <div class="hero__visual" data-hero-visual>
        <div class="hero__orbit" aria-hidden="true">
          <svg viewBox="0 0 400 400"><defs><path id="orbit-path" d="M200,200 m-170,0 a170,170 0 1,1 340,0 a170,170 0 1,1 -340,0"/></defs>
            <text><textPath href="#orbit-path"><%= settings.brandNameEn || 'INTERRA' %> · PREMIUM SKINCARE · PEPTIDE BOTULEXO · SALON EDITION · <%= (settings.brandNameEn || 'INTERRA') %> · </textPath></text>
          </svg>
        </div>
        <a class="hero__product" href="<%= productUrl(heroProduct) %>">
          <img src="<%= heroProduct.images[0] %>" alt="<%= heroProduct.name %>" width="800" height="1000" fetchpriority="high">
          <span class="hero__tag"><em><%= heroProduct.badge || 'SIGNATURE' %></em><%= heroProduct.name %></span>
        </a>
        <% if (settings.awardBadge) { %>
        <div class="seal hero__seal" aria-label="<%= settings.awardTitle %> <%= settings.awardBadge %>">
          <svg class="seal__ring" viewBox="0 0 200 200" aria-hidden="true"><defs><path id="seal-path" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"/></defs>
            <text><textPath href="#seal-path"><%= settings.awardTitle %> · <%= settings.awardCategory %> · </textPath></text></svg>
          <span class="seal__core"><small>AWARD</small><strong><%= settings.awardBadge %></strong></span>
        </div>
        <% } %>
      </div>
      <% } %>
    </div>
    <a class="scroll-hint" href="#story" aria-label="아래로 스크롤"><span></span>SCROLL</a>
  </section>

  <!-- MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track" data-marquee>
      <% for (let i = 0; i < 2; i++) { %>
      <span><%= settings.brandNameEn || 'INTERRA' %></span><i>✦</i><span><%= settings.awardTitle %> <%= settings.awardBadge %></span><i>✦</i><span>Premium Skincare &amp; Salon Edition</span><i>✦</i><span>전화 한 통으로 시작하는 맞춤 상담</span><i>✦</i>
      <% } %>
    </div>
  </div>

  <!-- STORY -->
  <section class="story" id="story">
    <div class="container story__grid">
      <div class="story__media" data-reveal-img>
        <div class="story__img-wrap">
          <img src="<%= (featured[1] && featured[1].images[0]) || (products[0] && products[0].images[0]) || '' %>" alt="" loading="lazy" data-parallax="-12">
        </div>
        <div class="story__badge" data-reveal><span>Brand</span><strong><%= settings.brandNameEn || 'INTERRA' %></strong><span>Premium</span></div>
      </div>
      <div class="story__copy">
        <p class="eyebrow" data-reveal>BRAND STORY</p>
        <h2 class="h2" data-split><%= settings.storyTitle %></h2>
        <% paragraphs(settings.storyText).forEach(function (para) { %>
          <p class="story__text" data-reveal><%= para %></p>
        <% }) %>
        <dl class="stats" data-reveal>
          <div><dt>엄선 제품</dt><dd><span data-count="<%= products.length %>">0</span><small>종</small></dd></div>
          <div><dt>고객감동브랜드대상</dt><dd><span data-count="<%= awardYears.length %>">0</span><small>년 연속</small></dd></div>
          <div><dt>온라인 결제</dt><dd><span>0</span><small>원</small></dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- AWARDS -->
  <% if (awardYears.length) { %>
  <section class="awards" id="awards">
    <div class="awards__glow" aria-hidden="true"></div>
    <div class="container">
      <div class="awards__head">
        <p class="eyebrow" data-reveal>AWARDS</p>
        <h2 class="h2 awards__title" data-reveal><%= settings.awardBadge %></h2>
        <p class="lead" data-reveal><%= settings.brandName %>는 <%= settings.awardTitle %> <%= settings.awardCategory %>에서<br class="br-pc"> <%= awardYears.join(' · ') %>년, 고객이 직접 선택한 브랜드로 대상을 수상했습니다.</p>
      </div>
      <ol class="awards__list">
        <% awardYears.forEach(function (y, i) { %>
        <li class="medal" data-medal>
          <div class="medal__ring">
          <svg class="medal__laurel" viewBox="0 0 240 240" aria-hidden="true">
            <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
              <path d="M120 206 C 62 196, 30 150, 36 92"/><path d="M120 206 C 178 196, 210 150, 204 92"/>
            </g>
            <g fill="currentColor" opacity=".85">
              <% [0,1,2,3,4,5,6].forEach(function (k) { const t = k / 7; const a = Math.PI * (0.62 + t * 0.42); const x = 120 + Math.cos(a) * 88, yy = 120 + Math.sin(a) * 88 * 0.98; %>
                <ellipse cx="<%= x.toFixed(1) %>" cy="<%= yy.toFixed(1) %>" rx="11" ry="4.6" transform="rotate(<%= (a * 180 / Math.PI + 60).toFixed(0) %> <%= x.toFixed(1) %> <%= yy.toFixed(1) %>)"/>
                <ellipse cx="<%= (240 - x).toFixed(1) %>" cy="<%= yy.toFixed(1) %>" rx="11" ry="4.6" transform="rotate(<%= (-(a * 180 / Math.PI) - 60).toFixed(0) %> <%= (240 - x).toFixed(1) %> <%= yy.toFixed(1) %>)"/>
              <% }) %>
            </g>
          </svg>
          <div class="medal__body">
            <span class="medal__year"><%= y %></span>
            <span class="medal__rank">대상</span>
          </div>
          </div>
          <p class="medal__caption"><span class="medal__title"><%= settings.awardTitle %></span><span class="medal__cat"><%= settings.awardCategory %></span></p>
        </li>
        <% }) %>
      </ol>
    </div>
  </section>
  <% } %>

  <!-- SIGNATURE PRODUCTS -->
  <section class="showcase" data-showcase>
    <div class="showcase__pin">
      <div class="container showcase__head">
        <div>
          <p class="eyebrow" data-reveal>SIGNATURE</p>
          <h2 class="h2" data-split><%= settings.brandName %> 시그니처</h2>
        </div>
        <a class="link-arrow" href="/products" data-reveal>전체 제품 보기 <span>→</span></a>
      </div>
      <div class="showcase__track" data-showcase-track>
        <% featured.forEach(function (p) { %>
          <%- include('partials/product-card', { p }) %>
        <% }) %>
        <a class="showcase__more" href="/products">
          <span>All<br>Products</span>
          <em>전체 <%= products.length %>개 제품 보기 →</em>
        </a>
      </div>
      <div class="showcase__progress" aria-hidden="true"><span data-showcase-bar></span></div>
    </div>
  </section>

  <!-- LINE UP -->
  <% const cats = products.reduce(function (acc, p) { if (p.category) { acc[p.category] = acc[p.category] || []; acc[p.category].push(p); } return acc; }, {}); %>
  <% if (Object.keys(cats).length > 1) { %>
  <section class="lineup">
    <div class="container">
      <p class="eyebrow" data-reveal>LINE UP</p>
      <h2 class="h2" data-split>일상의 모든 아름다움을 위한 <%= Object.keys(cats).length %>개의 라인</h2>
      <div class="lineup__grid">
        <% Object.keys(cats).forEach(function (c) { const list = cats[c]; %>
        <a class="lineup__item" href="/products?category=<%= encodeURIComponent(c) %>" data-reveal>
          <div class="lineup__media"><img src="<%= list[0].images[0] %>" alt="" loading="lazy" data-parallax="-8"></div>
          <div class="lineup__body">
            <% const info = categoryInfo[c] || {}; %>
            <% if (info.en) { %><p class="lineup__en"><%= info.en %></p><% } %>
            <h3><%= c %></h3>
            <p><%= info.desc || list.map(function (p) { return p.name.replace(/^인테라( 에디션)? /, ''); }).slice(0, 3).join(' · ') %></p>
            <span class="lineup__count"><%= list.length %>개 제품 →</span>
          </div>
        </a>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- VALUES -->
  <section class="values">
    <div class="container">
      <p class="eyebrow" data-reveal>WHY <%= settings.brandNameEn || 'INTERRA' %></p>
      <h2 class="h2" data-split><%= settings.brandName %>를 믿고 고르는 이유</h2>
      <div class="values__grid">
        <article class="value" data-reveal>
          <span class="value__num">01</span>
          <h3>특허 기술의 펩타이드 케어</h3>
          <p>특허받은 PTD 기술(특허 제10-0612673호)의 보툴리눔 펩타이드를 담은 보툴엑소 라인을 중심으로, 피부 본연의 힘을 생각합니다.</p>
        </article>
        <article class="value" data-reveal>
          <span class="value__num">02</span>
          <h3><%= settings.awardBadge || '고객이 인정한 브랜드' %></h3>
          <p><%= settings.awardTitle %> <%= settings.awardCategory %> 수상. 고객 만족으로 증명해 온 브랜드입니다.</p>
        </article>
        <article class="value" data-reveal>
          <span class="value__num">03</span>
          <h3>24시간 1:1 상담</h3>
          <p>전화 · 문자 · 상담 신청 모두 24시간 언제든 가능합니다. 고민을 듣고 꼭 맞는 제품만 추천해 드립니다.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- HOW TO BUY -->
  <section class="how" id="how">
    <div class="container">
      <div class="how__head">
        <p class="eyebrow" data-reveal>HOW TO BUY</p>
        <h2 class="h2" data-split>구매는 이렇게 진행됩니다</h2>
        <p class="lead" data-reveal>홈페이지에서는 결제가 진행되지 않습니다. 아래 순서로 편하게 문의해 주세요.</p>
      </div>
      <ol class="steps" data-steps>
        <li class="step" data-reveal>
          <span class="step__num">STEP 01</span>
          <h3>제품 둘러보기</h3>
          <p>홈페이지에서 제품 정보와 가격을 확인하세요.</p>
        </li>
        <li class="step" data-reveal>
          <span class="step__num">STEP 02</span>
          <h3>전화 · 문자 문의</h3>
          <p><a href="<%= telHref(settings.phone) %>"><%= settings.phone %></a> 로 24시간 언제든 연락 주시거나 상담 신청을 남겨주세요.</p>
        </li>
        <li class="step" data-reveal>
          <span class="step__num">STEP 03</span>
          <h3>맞춤 상담</h3>
          <p>피부 고민에 맞는 제품과 구성, 수량을 함께 정합니다.</p>
        </li>
        <li class="step" data-reveal>
          <span class="step__num">STEP 04</span>
          <h3>입금 확인 후 발송</h3>
          <p>안내드린 계좌로 입금이 확인되면 꼼꼼히 포장해 보내드립니다.</p>
        </li>
      </ol>
    </div>
  </section>

  <%- include('partials/inquiry', { back: '/' }) %>
</main>

<%- include('partials/footer') %>
