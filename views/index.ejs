<%- include('partials/head') %>
<%- include('partials/header', { bodyClass: 'is-home' }) %>

<div class="intro" data-intro aria-hidden="true">
  <div class="intro__mark">
    <% (settings.brandNameEn || 'J&COSU').split('').forEach(function (ch) { %><span><%= ch %></span><% }) %>
  </div>
  <div class="intro__line"></div>
</div>

<main id="main">
  <!-- HERO -->
  <section class="hero" data-hero>
    <canvas class="hero__canvas" data-peptide-canvas aria-hidden="true"></canvas>
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow hero__eyebrow" data-hero-in><%= settings.heroEyebrow %></p>
        <h1 class="hero__title">
          <% String(settings.heroTitle || '').split('\n').forEach(function (line) { %>
            <span class="line"><span class="line__inner" data-hero-line><%= line %></span></span>
          <% }) %>
        </h1>
        <p class="hero__sub" data-hero-in>
          <% String(settings.heroSubtitle || '').split('\n').forEach(function (line) { %><span><%= line %></span><% }) %>
        </p>
        <div class="hero__cta" data-hero-in>
          <a class="btn" href="/products" data-magnetic>제품 둘러보기</a>
          <a class="btn btn--ghost" href="<%= telHref(settings.phone) %>" data-magnetic>전화 구매 문의</a>
        </div>
      </div>
      <% const heroProduct = featured[0]; %>
      <% if (heroProduct && heroProduct.images && heroProduct.images[0]) { %>
      <div class="hero__visual" data-hero-visual>
        <div class="hero__orbit" aria-hidden="true">
          <svg viewBox="0 0 400 400"><defs><path id="orbit-path" d="M200,200 m-170,0 a170,170 0 1,1 340,0 a170,170 0 1,1 -340,0"/></defs>
            <text><textPath href="#orbit-path">PEPTIDE · VOLUME · ELASTICITY · SILK LAYER · MOISTURE · <%= (settings.brandNameEn || 'J&COSU') %> · </textPath></text>
          </svg>
        </div>
        <a class="hero__product" href="<%= productUrl(heroProduct) %>">
          <img src="<%= heroProduct.images[0] %>" alt="<%= heroProduct.name %>" width="800" height="1000" fetchpriority="high">
          <span class="hero__tag"><em><%= heroProduct.badge || 'SIGNATURE' %></em><%= heroProduct.name %></span>
        </a>
      </div>
      <% } %>
    </div>
    <a class="scroll-hint" href="#story" aria-label="아래로 스크롤"><span></span>SCROLL</a>
  </section>

  <!-- MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track" data-marquee>
      <% for (let i = 0; i < 2; i++) { %>
      <span>Peptide Skin Science</span><i>✦</i><span>탄력의 깊이</span><i>✦</i><span>Volume &amp; Silk Layer</span><i>✦</i><span>전화 한 통으로 시작하는 맞춤 상담</span><i>✦</i>
      <% } %>
    </div>
  </div>

  <!-- STORY -->
  <section class="story" id="story">
    <div class="container story__grid">
      <div class="story__media" data-reveal-img>
        <div class="story__img-wrap">
          <img src="<%= (featured[1] && featured[1].images[0]) || (products[0] && products[0].images[0]) || '' %>" alt="" loading="lazy" data-parallax="-12">
        </div>
        <div class="story__badge" data-reveal><span>Since</span><strong>Peptide</strong><span>Care</span></div>
      </div>
      <div class="story__copy">
        <p class="eyebrow" data-reveal>BRAND STORY</p>
        <h2 class="h2" data-split><%= settings.storyTitle %></h2>
        <% paragraphs(settings.storyText).forEach(function (para) { %>
          <p class="story__text" data-reveal><%= para %></p>
        <% }) %>
        <dl class="stats" data-reveal>
          <div><dt>엄선 제품</dt><dd><span data-count="<%= products.length %>">0</span><small>종</small></dd></div>
          <div><dt>1:1 맞춤 상담</dt><dd><span data-count="100">0</span><small>%</small></dd></div>
          <div><dt>온라인 결제</dt><dd><span>0</span><small>원</small></dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- SIGNATURE PRODUCTS -->
  <section class="showcase" data-showcase>
    <div class="showcase__pin">
      <div class="container showcase__head">
        <div>
          <p class="eyebrow" data-reveal>SIGNATURE</p>
          <h2 class="h2" data-split>제이앤코슈의 시그니처</h2>
        </div>
        <a class="link-arrow" href="/products" data-reveal>전체 제품 보기 <span>→</span></a>
      </div>
      <div class="showcase__track" data-showcase-track>
        <% featured.forEach(function (p) { %>
          <%- include('partials/product-card', { p }) %>
        <% }) %>
        <a class="showcase__more" href="/products">
          <span>All<br>Products</span>
          <em>전체 <%= products.length %>개 제품 보기 →</em>
        </a>
      </div>
      <div class="showcase__progress" aria-hidden="true"><span data-showcase-bar></span></div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="values">
    <div class="container">
      <p class="eyebrow" data-reveal>OUR PROMISE</p>
      <h2 class="h2" data-split>제이앤코슈가 약속하는 세 가지</h2>
      <div class="values__grid">
        <article class="value" data-reveal>
          <span class="value__num">01</span>
          <h3>엄선된 펩타이드 라인</h3>
          <p>검증된 브랜드의 펩타이드 스킨케어만을 골라 소개합니다. 제품 하나하나의 특징을 직접 설명해 드립니다.</p>
        </article>
        <article class="value" data-reveal>
          <span class="value__num">02</span>
          <h3>1:1 맞춤 상담</h3>
          <p>피부 타입과 고민을 듣고 꼭 필요한 제품만 추천해 드립니다. 불필요한 구매를 권하지 않습니다.</p>
        </article>
        <article class="value" data-reveal>
          <span class="value__num">03</span>
          <h3>믿을 수 있는 직접 거래</h3>
          <p>대표가 직접 전화로 안내하고 발송까지 책임집니다. 구매 후에도 사용법을 편하게 물어보세요.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- HOW TO BUY -->
  <section class="how" id="how">
    <div class="container">
      <div class="how__head">
        <p class="eyebrow" data-reveal>HOW TO BUY</p>
        <h2 class="h2" data-split>구매는 이렇게 진행됩니다</h2>
        <p class="lead" data-reveal>홈페이지에서는 결제가 진행되지 않습니다. 아래 순서로 편하게 문의해 주세요.</p>
      </div>
      <ol class="steps" data-steps>
        <li class="step" data-reveal>
          <span class="step__num">STEP 01</span>
          <h3>제품 둘러보기</h3>
          <p>홈페이지에서 제품 정보와 가격을 확인하세요.</p>
        </li>
        <li class="step" data-reveal>
          <span class="step__num">STEP 02</span>
          <h3>전화 · 문자 문의</h3>
          <p><a href="<%= telHref(settings.phone) %>"><%= settings.phone %></a> 로 연락 주시거나 상담 신청을 남겨주세요.</p>
        </li>
        <li class="step" data-reveal>
          <span class="step__num">STEP 03</span>
          <h3>맞춤 상담</h3>
          <p>피부 고민에 맞는 제품과 구성, 수량을 함께 정합니다.</p>
        </li>
        <li class="step" data-reveal>
          <span class="step__num">STEP 04</span>
          <h3>입금 확인 후 발송</h3>
          <p>안내드린 계좌로 입금이 확인되면 꼼꼼히 포장해 보내드립니다.</p>
        </li>
      </ol>
    </div>
  </section>

  <%- include('partials/inquiry', { back: '/' }) %>
</main>

<%- include('partials/footer') %>
