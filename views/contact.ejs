<%- include('partials/head') %>
<%- include('partials/header', { bodyClass: 'is-sub' }) %>

<main id="main">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow" data-reveal>CONTACT</p>
      <h1 class="h1" data-split>무엇이든 편하게 물어보세요</h1>
      <p class="lead" data-reveal>제품 추천, 구매, 배송, 사용법까지 대표가 직접 안내해 드립니다.</p>
    </div>
  </section>

  <section class="contact-cards container">
    <a class="contact-card" href="<%= telHref(settings.phone) %>" data-reveal data-tilt>
      <span class="eyebrow">CALL</span>
      <strong><%= settings.phone %></strong>
      <p>가장 빠른 상담 방법입니다.<br><%= settings.hours %></p>
    </a>
    <a class="contact-card" href="<%= smsHref(settings.phone, '[' + settings.brandName + '] 제품 문의드립니다.') %>" data-reveal data-tilt>
      <span class="eyebrow">MESSAGE</span>
      <strong>문자 문의</strong>
      <p>통화가 어려우시면 문자로 남겨주세요.<br>확인 후 바로 답장드립니다.</p>
    </a>
    <a class="contact-card" href="#inquiry" data-reveal data-tilt>
      <span class="eyebrow">CALLBACK</span>
      <strong>상담 신청</strong>
      <p>연락처를 남겨주시면<br>원하시는 시간에 먼저 연락드립니다.</p>
    </a>
  </section>

  <%- include('partials/inquiry', { back: '/contact' }) %>
</main>

<%- include('partials/footer') %>
