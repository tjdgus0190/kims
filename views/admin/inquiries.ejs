<%- include('_top', { title: '고객 문의' }) %>
<div class="a-head">
  <div>
    <h1>고객 문의</h1>
    <p class="a-muted">홈페이지 ‘상담 신청’으로 접수된 문의입니다. 연락 후 ‘처리 완료’로 표시해 주세요.</p>
  </div>
</div>

<% if (!channels.email && !channels.sms) { %>
  <p class="a-notice">메일 알림이 아직 설정되지 않았습니다. 새 문의가 들어와도 알림이 가지 않으니 이 화면을 확인해 주세요. (설정 방법: README의 ‘상담 신청 메일 알림’)</p>
<% } else { %>
  <p class="a-muted" style="margin-bottom:12px">새 문의가 들어오면
    <% if (channels.email) { %><b><%= mailTo %></b> 로 메일<% } %><% if (channels.email && channels.sms) { %>, <% } %><% if (channels.sms) { %><b><%= smsTo %></b> 로 문자<% } %>이 발송됩니다.</p>
<% } %>
<div class="a-list">
  <% inquiries.forEach(function (q) { %>
  <article class="a-inq<%= q.status === 'done' ? ' is-done' : '' %>">
    <div class="a-inq__head">
      <b class="a-tag <%= q.status === 'done' ? '' : 'a-tag--new' %>"><%= q.status === 'done' ? '처리 완료' : '새 문의' %></b>
      <time class="a-muted"><%= new Date(q.createdAt).toLocaleString('ko-KR', { timeZone: 'Asia/Seoul' }) %></time>
      <% const mail = q.notified && q.notified.email; %>
      <% if (mail === 'sent') { %><span class="a-tag a-tag--ok" title="알림 메일 발송됨">메일 발송</span>
      <% } else if (mail && mail.indexOf('failed') === 0) { %><span class="a-tag a-tag--warn" title="<%= mail %>">메일 실패</span><% } %>
      <% const sms = q.notified && q.notified.sms; %>
      <% if (sms === 'sent') { %><span class="a-tag a-tag--ok" title="대표 휴대폰으로 문자 발송됨">문자 발송</span>
      <% } else if (sms && sms.indexOf('failed') === 0) { %><span class="a-tag a-tag--warn" title="<%= sms %>">문자 실패</span><% } %>
    </div>
    <h2><%= q.name %> <a class="a-phone" href="<%= telHref(q.phone) %>"><%= q.phone %></a></h2>
    <p class="a-muted">
      <% if (q.productName) { %>관심 제품: <b><%= q.productName %></b><% } %>
      <% if (q.preferredTime) { %> · 통화 희망: <%= q.preferredTime %><% } %>
    </p>
    <% if (q.message) { %><p class="a-inq__msg"><%= q.message %></p><% } %>
    <form method="post" action="/admin/inquiries/<%= q.id %>" class="a-inq__form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input name="memo" value="<%= q.memo || '' %>" placeholder="메모 (예: 10/3 통화 완료, 2개 주문)">
      <select name="status">
        <option value="new" <%= q.status !== 'done' ? 'selected' : '' %>>새 문의</option>
        <option value="done" <%= q.status === 'done' ? 'selected' : '' %>>처리 완료</option>
      </select>
      <button class="a-btn a-btn--sm" type="submit">저장</button>
    </form>
    <form method="post" action="/admin/inquiries/<%= q.id %>/delete" data-confirm="이 문의를 삭제할까요?">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="a-btn a-btn--text a-btn--sm" type="submit">삭제</button>
    </form>
  </article>
  <% }) %>
  <% if (!inquiries.length) { %><p class="a-empty">아직 접수된 문의가 없습니다.</p><% } %>
</div>
<%- include('_bottom') %>
