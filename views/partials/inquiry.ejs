<%
  const backUrl = typeof back !== 'undefined' ? back : path;
  const preselect = typeof selected !== 'undefined' ? selected : '';
  const list = typeof products !== 'undefined' ? products : [];
%>
<section class="inquiry" id="inquiry">
  <div class="container inquiry__grid">
    <div class="inquiry__intro" data-reveal>
      <p class="eyebrow">CONSULTATION</p>
      <h2 class="h2">구매 · 상담 문의</h2>
      <p class="lead">제이앤코슈는 온라인 결제 대신 <br class="br-pc">한 분 한 분과 직접 상담 후 구매를 도와드립니다.</p>
      <a class="inquiry__phone" href="<%= telHref(settings.phone) %>" data-magnetic>
        <span class="eyebrow">대표번호</span>
        <strong><%= settings.phone %></strong>
      </a>
      <p class="muted"><%= settings.hours %></p>
      <div class="inquiry__quick">
        <a class="btn" href="<%= telHref(settings.phone) %>">지금 전화하기</a>
        <a class="btn btn--ghost" href="<%= smsHref(settings.phone, '[' + settings.brandName + '] 제품 문의드립니다.') %>">문자 보내기</a>
        <% if (settings.kakaoUrl) { %><a class="btn btn--ghost" href="<%= settings.kakaoUrl %>" target="_blank" rel="noopener">카카오톡 상담</a><% } %>
      </div>
    </div>

    <form class="inquiry__form" method="post" action="/inquiry" data-reveal>
      <% if (sent === '1') { %>
        <div class="notice notice--ok" role="status">문의가 접수되었습니다. 확인 후 빠르게 연락드리겠습니다.</div>
      <% } else if (sent === 'error') { %>
        <div class="notice notice--err" role="alert">성함, 연락처, 개인정보 수집 동의를 확인해 주세요.</div>
      <% } else if (sent === 'limit') { %>
        <div class="notice notice--err" role="alert">잠시 후 다시 시도해 주시거나 대표번호로 연락 주세요.</div>
      <% } %>
      <p class="inquiry__form-title">연락처를 남겨주시면 <em>먼저 연락드립니다</em></p>
      <input type="hidden" name="back" value="<%= backUrl %>">
      <div class="hp" aria-hidden="true"><label>웹사이트<input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
      <div class="field-row">
        <label class="field"><span>성함 *</span><input name="name" required maxlength="40" autocomplete="name"></label>
        <label class="field"><span>연락처 *</span><input name="phone" type="tel" required inputmode="tel" placeholder="010-0000-0000" pattern="[0-9+\-\s()]{8,}" autocomplete="tel"></label>
      </div>
      <div class="field-row">
        <label class="field"><span>관심 제품</span>
          <select name="product">
            <option value="">선택 안 함 (상담 후 추천)</option>
            <% list.forEach(function (p) { %><option value="<%= p.id %>"<%= p.id === preselect ? ' selected' : '' %>><%= p.name %></option><% }) %>
          </select>
        </label>
        <label class="field"><span>통화 가능 시간</span>
          <select name="time">
            <option value="">언제든 괜찮아요</option><option>오전 (10–12시)</option><option>오후 (12–15시)</option><option>오후 (15–18시)</option><option>문자로 먼저 연락 주세요</option>
          </select>
        </label>
      </div>
      <label class="field"><span>문의 내용</span><textarea name="message" rows="4" maxlength="2000" placeholder="피부 고민, 원하시는 수량, 선물 포장 여부 등을 자유롭게 남겨주세요."></textarea></label>
      <label class="agree">
        <input type="checkbox" name="agree" required>
        <span>개인정보 수집·이용에 동의합니다. <small>(수집 항목: 성함, 연락처 / 목적: 구매 상담 / 보유기간: 상담 완료 후 1년)</small></span>
      </label>
      <button class="btn btn--block" type="submit" data-magnetic>상담 신청하기</button>
    </form>
  </div>
</section>
