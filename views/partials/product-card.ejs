<article class="p-card" data-tilt>
  <a href="<%= productUrl(p) %>" class="p-card__link">
    <div class="p-card__media">
      <% if (p.badge) { %><span class="p-card__badge"><%= p.badge %></span><% } %>
      <% if (p.images && p.images[0]) { %>
        <img src="<%= p.images[0] %>" alt="<%= p.name %>" loading="lazy" decoding="async" width="800" height="1000">
      <% } else { %>
        <div class="p-card__noimg" aria-hidden="true"><%= (settings.brandNameEn || 'INTERRA') %></div>
      <% } %>
      <span class="p-card__view">자세히 보기</span>
    </div>
    <div class="p-card__body">
      <p class="p-card__meta"><%= [p.brand, p.category, p.capacity].filter(Boolean).join(' · ') %></p>
      <h3 class="p-card__name"><%= p.name %></h3>
      <p class="p-card__price">
        <span class="p-card__label">소비자가</span>
        <strong><%= p.price ? won(p.price) : '상담 시 안내' %></strong>
      </p>
    </div>
  </a>
</article>
