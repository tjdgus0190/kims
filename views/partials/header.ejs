<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<a class="skip-link" href="#main">본문 바로가기</a>

<div class="cursor" aria-hidden="true"><span class="cursor__dot"></span><span class="cursor__ring"></span></div>

<header class="site-header" data-header>
  <div class="site-header__inner">
    <a class="logo" href="/" aria-label="<%= settings.brandName %> 홈">
      <span class="logo__en"><%= settings.brandNameEn || 'INTERRA' %></span>
      <span class="logo__ko"><%= settings.brandName %></span>
    </a>
    <nav class="gnb" aria-label="주요 메뉴">
      <a href="/#story" class="gnb__link">브랜드</a>
      <a href="/products" class="gnb__link<%= path.startsWith('/products') ? ' is-active' : '' %>">제품</a>
      <a href="/catalog" class="gnb__link<%= path === '/catalog' ? ' is-active' : '' %>">카탈로그</a>
      <a href="/#how" class="gnb__link">구매 안내</a>
      <a href="/contact" class="gnb__link<%= path === '/contact' ? ' is-active' : '' %>">문의하기</a>
    </nav>
    <a class="header-call" href="<%= telHref(settings.phone) %>" data-magnetic>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
      <span><%= settings.phone %></span><em class="h24">24H</em>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="sr-only">메뉴 열기</span><i></i><i></i>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
  <nav aria-label="모바일 메뉴">
    <a href="/#story">브랜드</a>
    <a href="/products">제품</a>
    <a href="/catalog">카탈로그</a>
    <a href="/#how">구매 안내</a>
    <a href="/contact">문의하기</a>
  </nav>
  <div class="mobile-menu__foot">
    <p class="eyebrow">구매 · 상담 문의</p>
    <a class="mobile-menu__phone" href="<%= telHref(settings.phone) %>"><%= settings.phone %></a>
    <p class="muted"><span class="h24">24H</span> <%= settings.hours %></p>
  </div>
</div>
